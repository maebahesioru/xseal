{
  "manifest_version": 3,
  "name": "xseal — X封印ポスト (xo)",
  "version": "1.0.0",
  "description": "Xの投稿・検索・DMを平文のまま出さずに封印し、タイムライン・DM・検索結果の上で復号する。鍵なし（xo形式）。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "xseal の設定を開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
